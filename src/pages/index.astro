---
import Layout from '../layouts/Layout.astro';
import Issue from '../components/Issue.astro';
import { loadStoryArchive } from '../../scripts/tags.mjs';
import type { Tag, StoryRecord } from '../lib/types';
const {issues, registry, records} = await loadStoryArchive();
const tagsBySlug = new Map<string, Tag>(registry.tags.map((tag: Tag) => [tag.slug, tag]));
const recordsById = new Map<string, StoryRecord>(records.map(record => [record.id, record]));
---
<Layout>{issues.length ? <Issue issue={issues[0]} tagsBySlug={tagsBySlug} recordsById={recordsById}/> : <section><p class="eyebrow">A weekly perspective</p><h1>This Week in Hacker News</h1><p>A reviewed roundup of the stories and conversations that mattered on Hacker News.</p><p>No issues have been published yet. The archive will appear here after the first reviewed issue is ready.</p></section>}<nav aria-label="Issue archive"><h2>Archive</h2>{issues.length ? <ul>{issues.map(issue => <li><a href={`/issues/${issue.issueId}/`}>{issue.issueId}</a> · revision {issue.revision}</li>)}</ul> : <p>The archive is currently empty.</p>}</nav></Layout>
