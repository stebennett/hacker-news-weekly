---
import Layout from '../../layouts/Layout.astro';
import Issue from '../../components/Issue.astro';
import { loadArchive } from '../../../scripts/content.mjs';
export async function getStaticPaths() { const {issues} = await loadArchive(); return issues.map(issue => ({params:{issue:issue.issueId},props:{issue}})); }
const {issue} = Astro.props;
---
<Layout title={`This Week in Hacker News — ${issue.issueId}`} path={`/issues/${issue.issueId}/`}><Issue issue={issue}/><p><a href="/">Latest issue and full archive</a></p></Layout>
