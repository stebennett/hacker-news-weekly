---
import '../styles/global.css';
interface Props { title?: string; path?: string; }
const { title = 'This Week in Hacker News', path = '/' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content="A reviewed weekly roundup of Hacker News stories and discussion."/><link rel="canonical" href={new URL(path, 'https://twihn.com')}/></head><body><a class="skip" href="#main">Skip to content</a><header><a href="/" class="brand">This Week in Hacker News</a><nav aria-label="Main navigation"><a href="/tags/">Tags</a></nav></header><main id="main"><slot/></main><footer><p>Independent of Hacker News and Y Combinator. No tracking or analytics.</p><a href="/data/index.json">Public JSON archive</a> · <a href="/schema/issue.schema.json">Issue schema v1</a></footer></body></html>
