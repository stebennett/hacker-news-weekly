---
import { HEADINGS } from '../../scripts/content.mjs';
import type { Issue } from '../lib/types';
interface Props { issue: Issue; }
const { issue } = Astro.props;
const local = (date: string) => new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/London',dateStyle:'medium',timeStyle:'short'}).format(new Date(date));
---
<article><h1>Week of {issue.issueId}</h1>
{issue.sections.map((section,index) => <section aria-labelledby={`section-${section.id}`}><h2 id={`section-${section.id}`}>{HEADINGS[index]}</h2>{section.itemIds.length === 0 ? <p>{index === 3 ? 'None met the 50-point threshold this week.' : 'No qualifying entries in this window.'}</p> : <ol>{section.itemIds.map((id: string) => {const item=issue.items[id]; return <li data-hn-id={id}><h3><a href={item.sourceUrl || item.discussionUrl} rel="noreferrer">{item.title}</a></h3><p class="meta">{item.score} points · {item.comments} comments · {local(item.submittedAt)} (Europe/London) · <a href={item.discussionUrl}>HN discussion</a></p><p><strong>Story</strong> — {item.story}</p><p><strong>Discussion</strong> — {item.discussion}</p></li>;})}</ol>}{index < 3 && section.itemIds.length < 10 && <p class="meta">Only {index === 1 ? Math.max(0, section.qualifyingCount - issue.sections[0].itemIds.length) : section.qualifyingCount} qualifying entries were available in this window.</p>}</section>)}
</article>
