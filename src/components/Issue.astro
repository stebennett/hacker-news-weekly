---
import { HEADINGS } from '../../scripts/content.mjs';
import type { Issue } from '../lib/types';
interface Props { issue: Issue; }
const { issue } = Astro.props;
const local = (date: string) => new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/London',dateStyle:'medium',timeStyle:'short'}).format(new Date(date));
---
<article><h1>Week of {issue.issueId}</h1><p class="meta">Window: {local(issue.window.start)} – {local(issue.window.end)} (Europe/London). Collected {local(issue.collectedAt)}. Revision {issue.revision}.</p>
{issue.correction && <aside aria-label="Correction"><strong>Correction — revision {issue.revision}</strong><p>{issue.correction.note}</p><p>{local(issue.correction.correctedAt)} (Europe/London) · <a href={`/data/revisions/${issue.issueId}/v${issue.correction.previousRevision}.json`}>Previous published revision</a></p></aside>}
<p class="methodology">Popularity means HN score and comment count, ranked independently: stories can appear in both lists. Ask HN is ranked by comments; every Show HN thread with at least 50 points is included. Discussion themes reflect prominent visible threads, not unavailable comment vote scores. Rankings use observations at collection, not current scores.</p>
<p><a href={`/issues/${issue.issueId}/`}>Issue permalink</a> · <a href={`/data/issues/${issue.issueId}.json`}>Reviewed JSON</a></p>
{issue.sections.map((section,index) => <section aria-labelledby={`section-${section.id}`}><h2 id={`section-${section.id}`}>{HEADINGS[index]}</h2>{section.itemIds.length === 0 ? <p>{index === 3 ? 'None met the 50-point threshold this week.' : 'No qualifying entries in this window.'}</p> : <ol>{section.itemIds.map((id: string) => {const item=issue.items[id]; return <li data-hn-id={id}><h3><a href={item.sourceUrl || item.discussionUrl} rel="noreferrer">{item.title}</a></h3><p class="meta">{item.score} points · {item.comments} comments · {local(item.submittedAt)} (Europe/London) · <a href={item.discussionUrl}>HN discussion</a></p><p><strong>Story</strong> — {item.story}</p><p><strong>Discussion</strong> — {item.discussion}</p><details><summary>Sources and availability</summary><p>Story ({item.availability.story.status}): {item.availability.story.note}</p><p>Discussion ({item.availability.discussion.status}): {item.availability.discussion.note}</p><ul>{item.sources.map((source: any) => <li><a href={source.url}>{source.kind} source</a></li>)}</ul></details></li>;})}</ol>}{index < 3 && section.itemIds.length < 10 && <p class="meta">Only {section.qualifyingCount} qualifying entries were available in this window.</p>}</section>)}
</article>
