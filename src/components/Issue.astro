---
import { HEADINGS } from '../../scripts/content.mjs';
import Story from './Story.astro';
import type { Issue, Tag, StoryRecord } from '../lib/types';
interface Props { issue: Issue; tagsBySlug: Map<string, Tag>; recordsById: Map<string, StoryRecord>; }
const { issue, tagsBySlug, recordsById } = Astro.props;
---
<article><h1>Week of {issue.issueId}</h1>
{issue.sections.map((section,index) => <section aria-labelledby={`section-${section.id}`}><h2 id={`section-${section.id}`}>{HEADINGS[index]}</h2>{section.itemIds.length === 0 ? <p>{index === 3 ? 'None met the 50-point threshold this week.' : 'No qualifying entries in this window.'}</p> : <ol>{section.itemIds.map((id: string) => <Story item={issue.items[id]} tags={recordsById.get(id)!.tagSlugs.map(slug => tagsBySlug.get(slug)!)}/>)}</ol>}{index < 3 && section.itemIds.length < 10 && <p class="meta">Only {index === 1 ? Math.max(0, section.qualifyingCount - issue.sections[0].itemIds.length) : section.qualifyingCount} qualifying entries were available in this window.</p>}</section>)}
</article>
