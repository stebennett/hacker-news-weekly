---
import Layout from '../layouts/Layout.astro';
import Story from './Story.astro';
import { pageSize } from '../../scripts/tags.mjs';
import type { ResolvedStory, Tag, TagRegistry } from '../lib/types';
interface Props {
  archive: {
    tag: Tag;
    page: number;
    pageCount: number;
    storyCount: number;
    stories: ResolvedStory[];
    url: string;
    previousUrl: string | null;
    nextUrl: string | null;
  };
  registry: TagRegistry;
}
const { archive, registry } = Astro.props;
const tagsBySlug = new Map(registry.tags.map(tag => [tag.slug, tag]));
---
<Layout title={`${archive.tag.label} — Page ${archive.page} — This Week in Hacker News`} path={archive.url}>
  <h1>{archive.tag.label}</h1>
  <p>{archive.storyCount} {archive.storyCount === 1 ? 'story' : 'stories'}</p>
  <ol start={(archive.page - 1) * pageSize + 1}>
    {archive.stories.map(story => <Story item={story.item} tags={story.tagSlugs.map(slug => tagsBySlug.get(slug)!)} sourceIssueId={story.sourceIssueId}/>)}
  </ol>
  <nav class="pagination" aria-label="Tag archive pagination">
    {archive.previousUrl && <a href={archive.previousUrl} rel="prev">Previous</a>}
    <span aria-current="page">Page {archive.page} of {archive.pageCount}</span>
    {archive.nextUrl && <a href={archive.nextUrl} rel="next">Next</a>}
  </nav>
  <p><a href="/tags/">All tags</a></p>
</Layout>
