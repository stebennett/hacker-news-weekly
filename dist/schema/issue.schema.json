{
  "$comment": "All fields are public and allowlisted. Runtime validation via scripts/content.mjs validateIssue is also required: scheduled Friday 08:00 Europe/London identity; seven 24-hour UTC window ending at scheduledAt; submittedAt within the half-open window; sections ordered votes/comments/ask/show; score ranking takes precedence, so comments contain up to ten highest-commented remaining ordinary stories; all qualifying Show HN at 50+; IDs reference unique item records; qualifyingCount records the full collected population, not merely selected entries. Revisions >1 require correction metadata and all previous published revisions retained. URL validation additionally forbids credentials, whitespace, control characters, and backslashes. Availability notes must disclose inaccessible research rather than fabricate summaries.",
  "$id": "https://twihn.com/schema/issue.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "collectedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "correction": {
      "additionalProperties": false,
      "properties": {
        "correctedAt": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
          "type": "string"
        },
        "previousRevision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "previousRevision",
        "correctedAt",
        "note"
      ],
      "type": "object"
    },
    "displayTimezone": {
      "const": "Europe/London"
    },
    "issueId": {
      "format": "date",
      "type": "string"
    },
    "items": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "additionalProperties": false,
            "properties": {
              "discussion": {
                "additionalProperties": false,
                "properties": {
                  "note": {
                    "minLength": 1,
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "reviewed",
                      "unavailable",
                      "no-comments",
                      "text-post"
                    ]
                  }
                },
                "required": [
                  "status",
                  "note"
                ],
                "type": "object"
              },
              "story": {
                "additionalProperties": false,
                "properties": {
                  "note": {
                    "minLength": 1,
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "reviewed",
                      "unavailable",
                      "no-comments",
                      "text-post"
                    ]
                  }
                },
                "required": [
                  "status",
                  "note"
                ],
                "type": "object"
              }
            },
            "required": [
              "story",
              "discussion"
            ],
            "type": "object"
          },
          "comments": {
            "minimum": 0,
            "type": "integer"
          },
          "discussion": {
            "minLength": 1,
            "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
            "type": "string"
          },
          "discussionUrl": {
            "format": "uri",
            "pattern": "^https?://[^\\s]+$",
            "type": "string"
          },
          "id": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "story",
              "ask",
              "show"
            ]
          },
          "score": {
            "minimum": 0,
            "type": "integer"
          },
          "sourceUrl": {
            "format": "uri",
            "pattern": "^https?://[^\\s]+$",
            "type": "string"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "story",
                    "discussion"
                  ]
                },
                "url": {
                  "format": "uri",
                  "pattern": "^https?://[^\\s]+$",
                  "type": "string"
                }
              },
              "required": [
                "url",
                "kind"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "story": {
            "minLength": 1,
            "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
            "type": "string"
          },
          "submittedAt": {
            "format": "date-time",
            "pattern": "Z$",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "submittedAt",
          "score",
          "comments",
          "discussionUrl",
          "story",
          "discussion",
          "sources",
          "availability"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$",
        "type": "string"
      },
      "type": "object"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "scheduledAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "votes",
              "comments",
              "ask",
              "show"
            ]
          },
          "itemIds": {
            "items": {
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "qualifyingCount": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "itemIds",
          "qualifyingCount"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "issueId",
    "revision",
    "scheduledAt",
    "window",
    "collectedAt",
    "displayTimezone",
    "sections",
    "items"
  ],
  "title": "TWIHN reviewed public issue v1",
  "type": "object"
}
